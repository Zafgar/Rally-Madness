; Engine configuration file.
; Rally Madness

config_version=5

[application]

config/name="Rally Madness"
config/description="Top-down rally combat racer. 1-4 player local split-screen, up to 12 player LAN."
config/version="0.1.0"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/autoload/event_bus.gd"
GameConfig="*res://scripts/autoload/game_config.gd"
SaveSystem="*res://scripts/autoload/save_system.gd"
PartDatabase="*res://scripts/autoload/part_database.gd"
CarDatabase="*res://scripts/autoload/car_database.gd"
EventDatabase="*res://scripts/autoload/event_database.gd"
PlayerManager="*res://scripts/autoload/player_manager.gd"
NetManager="*res://scripts/autoload/net_manager.gd"
AudioDirector="*res://scripts/autoload/audio_director.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_touch_from_mouse=false

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="car"
2d_physics/layer_3="trigger"
2d_physics/layer_4="debris"

[physics]

common/physics_ticks_per_second=60
2d/default_gravity=0.0
2d/default_linear_damp=0.0
2d/default_angular_damp=0.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0

[input]

ui_accept={
